{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ctf-card-submission-email",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "vars": {
    "ALLOWED_ORIGIN": "https://professorzoom45.github.io",
    "EXPECTED_TURNSTILE_HOSTNAME": "professorzoom45.github.io",
    "EMAIL_TO": "changethewrld@outlook.com",
    "EMAIL_FROM": "Carry The Flame Cards <cards@REPLACE_WITH_VERIFIED_DOMAIN>"
  },
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
